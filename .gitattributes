* text=auto eol=lf
*.md text eol=lf
*.py text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.geojson text eol=lf
*.pbf binary
*.tif binary
*.tiff binary
*.zip binary

# Test fixtures encode specific byte sequences -- CRLF endings, BOMs, UTF-16.
# Normalising them would make the encoding tests pass vacuously on a fresh
# clone, testing nothing. Store them exactly as authored.
tests/fixtures/** -text
