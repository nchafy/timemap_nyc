{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "timemap places ingest report",
  "type": "object",
  "required": [
    "total_places",
    "located_count",
    "unresolved_count",
    "duplicates_merged",
    "outside_region_count",
    "unresolved_by_reason",
    "unresolved"
  ],
  "properties": {
    "total_places": {
      "type": "integer",
      "minimum": 0
    },
    "located_count": {
      "type": "integer",
      "minimum": 0
    },
    "unresolved_count": {
      "type": "integer",
      "minimum": 0
    },
    "duplicates_merged": {
      "type": "integer",
      "minimum": 0
    },
    "outside_region_count": {
      "type": "integer",
      "minimum": 0
    },
    "source_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_by_reason": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "lists",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "lists": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "url": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
